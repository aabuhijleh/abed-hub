{
  "name": "@aabuhijleh/gh-attach",
  "version": "0.1.0",
  "description": "Upload local files to GitHub and print a markdown reference for each, ready to embed in a pull request or issue. Also screenshots a page to a PNG sized for GitHub.",
  "keywords": [
    "github",
    "cli",
    "screenshot",
    "pull-request",
    "attachments",
    "bun"
  ],
  "homepage": "https://github.com/aabuhijleh/abed-hub/tree/main/packages/gh-attach",
  "bugs": "https://github.com/aabuhijleh/abed-hub/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aabuhijleh/abed-hub.git",
    "directory": "packages/gh-attach"
  },
  "license": "MIT",
  "author": "aabuhijleh",
  "type": "module",
  "bin": {
    "gh-attach": "./dist/gh-attach.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/gh-attach.ts --target=bun --outdir=./dist",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "devDependencies": {
    "@abed-hub/config": "workspace:*",
    "@types/bun": "latest",
    "citty": "^0.2.2"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
