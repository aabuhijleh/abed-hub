{
  "name": "abed-hub",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/bun": "latest",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24"
  }
}
